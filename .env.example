# Copia este archivo a .env y cambia TODOS los valores antes de usarlo fuera de tu PC.
# .env está en .gitignore: nunca lo subas al repositorio.

# --- Base de datos ---
DB_PASSWORD=cambia-esta-clave-db
# timescale (recomendado) | postgres (proveedores sin TimescaleDB, ver docs/adr/0004)
SENSONET_DB_FLAVOR=timescale

# --- JWT (mínimo 32 caracteres aleatorios; p. ej. `openssl rand -base64 48`) ---
JWT_SECRET=cambia-este-secreto-jwt-por-uno-largo-y-aleatorio-de-48-bytes

# --- Usuarios iniciales del dashboard (solo se crean si la tabla users está vacía) ---
SENSONET_ADMIN_EMAIL=admin@sensonet.local
SENSONET_ADMIN_PASSWORD=cambia-esta-clave-admin
SENSONET_VIEWER_EMAIL=viewer@sensonet.local
SENSONET_VIEWER_PASSWORD=cambia-esta-clave-viewer

# --- MQTT ---
# Contraseña del usuario "backend" en Mosquitto
MQTT_BACKEND_PASSWORD=cambia-esta-clave-backend
# Nodos permitidos: usuario:contraseña separados por coma. El usuario es el código del nodo
# y, por la ACL, solo puede publicar en sensonet/v1/<usuario>/...
MQTT_NODES=sim-sala:clave-sim-sala,sim-lab:clave-sim-lab,sim-bodega:clave-sim-bodega,nodo-sala:clave-nodo-sala

# --- Telegram (opcional; si está vacío las alertas solo se registran en el log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Simulador (perfil demo) ---
# Escenario: normal | ola-de-calor | corte-wifi
SIM_ESCENARIO=normal
SIM_NODOS=sim-sala,sim-lab,sim-bodega
SIM_INTERVALO=10

# --- Puertos en tu PC (cámbialos si ya están ocupados) ---
BACKEND_PORT=8080
FRONTEND_PORT=5173
